PORT=5000
NODE_ENV=development
DB_PATH=./data/alpha-flow-scanner.db

BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_FUTURES_WS=wss://fstream.binance.com/ws
DEFAULT_EXCHANGE=BINANCE

# ENABLE_COLLECTOR is reserved for future collector modes.
ENABLE_COLLECTOR=true
# Set to false to run only the API without the automatic scan loop.
ENABLE_AUTO_SCANNER=true

# The automatic scanner runs every 30 seconds by default.
AUTO_SCANNER_INTERVAL_MS=30000
AUTO_SCANNER_MARKET_LIMIT=80
AUTO_SCANNER_SIGNAL_LIMIT=5
